<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the stream survives the screen timing out mid-programme. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Television. Both are required="false", so the same APK installs on phones,
      tablets and TVs. Without the touchscreen line a TV is treated as unable to
      run the app, because declaring nothing implies a touchscreen is required —
      and televisions do not have one.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".IPTerebiApp"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPTerebi"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is not optional here. Xtream panels are
          overwhelmingly plain HTTP on a high port, and from API 28 Android
          blocks cleartext by default — the symptom is every single channel
          failing instantly while the API calls appear fine, because those were
          the same scheme and failed the same way one step earlier.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- What puts the app on a TV home screen, using the banner above. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
