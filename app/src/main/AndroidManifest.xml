<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the stream survives the screen timing out mid-programme. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Playing on with the screen off. Without a foreground service Android
      freezes an app with nothing on screen within seconds, stream and all.
      The media notification needs no POST_NOTIFICATIONS: media sessions are
      exempt from it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Television. Both are required="false", so the same APK installs on phones,
      tablets and TVs. Without the touchscreen line a TV is treated as unable to
      run the app, because declaring nothing implies a touchscreen is required —
      and televisions do not have one.
    -->
    <!--
      "Open in another player" asks whether any video player is installed
      before it stops the stream here. From Android 11 other apps are hidden
      unless declared, and this is the declaration: apps that view video, and
      HLS playlists, which some players list apart from video.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-mpegurl" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".IPTerebiApp"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPTerebi"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is not optional here. Xtream panels are
          overwhelmingly plain HTTP on a high port, and from API 28 Android
          blocks cleartext by default — the symptom is every single channel
          failing instantly while the API calls appear fine, because those were
          the same scheme and failed the same way one step earlier.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- What puts the app on a TV home screen, using the banner above. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Exported because the lock screen, headphones and watches find the
          session through it. What they may do with it is limited in
          BackgroundPlayback.kt: play, pause and, for a film, seek.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
