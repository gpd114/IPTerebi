<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 and later draw their own splash screen before the app's window,
      and it does not use windowBackground: without its own colour it follows the
      system's light or dark setting, and the app opened on a flash of the wrong
      one. It needs saying separately here. It is the Dark theme's page — the TV
      guide's near-black, the default; the choice of theme is not known until the
      app is running, so on Light the splash is dark for that moment.

      The whole style is repeated rather than inherited, because a style in a
      qualified folder replaces the one in values/ rather than adding to it.
    -->
    <style name="Theme.IPTerebi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0C11</item>
        <item name="android:windowSplashScreenBackground">#0B0C11</item>
    </style>
</resources>
