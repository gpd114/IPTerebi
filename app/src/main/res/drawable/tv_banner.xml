<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android TV home-screen banner: 320 x 180, the launcher's set-and-ears
  glyph on the launcher's background. A TV home screen shows this rather than
  the icon, and without one the app does not appear there at all.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0 L320,0 L320,180 L0,180 z" />
    <!-- The icon's glyph, centred and scaled from its 108-unit viewport. -->
    <group
        android:scaleX="1.8"
        android:scaleY="1.8"
        android:translateX="62.8"
        android:translateY="-12.6">
        <path
            android:strokeColor="#E8EEF4"
            android:strokeWidth="4"
            android:strokeLineJoin="round"
            android:pathData="M32,50 L54,34 L76,50" />
        <path
            android:strokeColor="#E8EEF4"
            android:strokeWidth="4"
            android:strokeLineJoin="round"
            android:pathData="M30,52 m0,4 a4,4 0 0 1 4,-4 l40,0 a4,4 0 0 1 4,4 l0,20 a4,4 0 0 1 -4,4 l-40,0 a4,4 0 0 1 -4,-4 z" />
    </group>
</vector>
