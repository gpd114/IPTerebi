<?xml version="1.0" encoding="utf-8"?>
<!--
  Terebi-kun: a glossy white set — a thick edge under it, a shadow on the
  ground, glare across the screen — with bobbles on its aerials and a happy
  face on a night-blue screen. Everything sits inside the 66dp safe circle of
  the 108dp adaptive-icon canvas, so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shadow on the ground. -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.32"
        android:pathData="M31,83 a23,3.4 0 1,0 46,0 a23,3.4 0 1,0 -46,0 z" />

    <!-- Aerials, with bobbles. -->
    <path
        android:strokeColor="#EAF1FB"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M54,36 L45,25 M54,36 L64,26" />
    <path
        android:fillColor="#FFE066"
        android:pathData="M41.2,25 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0 z M60.2,26 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0 z" />

    <!-- The set's thick edge, then its face. -->
    <path
        android:fillColor="#8FA6C4"
        android:pathData="M39,41 h30 a11,11 0 0,1 11,11 v16 a11,11 0 0,1 -11,11 h-30 a11,11 0 0,1 -11,-11 v-16 a11,11 0 0,1 11,-11 z" />
    <path android:pathData="M39,36 h30 a11,11 0 0,1 11,11 v16 a11,11 0 0,1 -11,11 h-30 a11,11 0 0,1 -11,-11 v-16 a11,11 0 0,1 11,-11 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="36"
                android:endX="54"
                android:endY="74">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFD5E0EF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The screen, with glare across it. -->
    <path android:pathData="M40,41 h28 a7,7 0 0,1 7,7 v14 a7,7 0 0,1 -7,7 h-28 a7,7 0 0,1 -7,-7 v-14 a7,7 0 0,1 7,-7 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="41"
                android:endX="75"
                android:endY="69">
                <item android:offset="0" android:color="#FF3A2F6E" />
                <item android:offset="1" android:color="#FF211A45" />
            </gradient>
        </aapt:attr>
    </path>
    <group>
        <clip-path android:pathData="M40,41 h28 a7,7 0 0,1 7,7 v14 a7,7 0 0,1 -7,7 h-28 a7,7 0 0,1 -7,-7 v-14 a7,7 0 0,1 7,-7 z" />
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.1"
            android:pathData="M33,41 L55,41 L40,69 L33,69 z" />
    </group>

    <!-- The face: happy eyes, a smile, blushing cheeks. -->
    <path
        android:strokeColor="#FFE066"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M41,56 q4,-5 8,0 M59,56 q4,-5 8,0" />
    <path
        android:strokeColor="#FF8FA3"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M50,61 q4,4 8,0" />
    <path
        android:fillColor="#FF6B8B"
        android:fillAlpha="0.75"
        android:pathData="M36.4,62 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 z M66.4,62 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 z" />
</vector>
